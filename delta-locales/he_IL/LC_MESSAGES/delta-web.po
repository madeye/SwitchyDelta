msgid "options_group_conflicts"
msgstr "התנגשויות"

msgid "options_conflicts_introduction"
msgstr "לפעמים אפליקציות אחרות גם ינסו לשלוט בהגדרות הפרוקסי, מה שגורם להתנגשויות. שים לב שחוסמי פרסומות והרחבות אחרות עשויים גם הם להשתמש בהגדרות פרוקסי מאחורי הקלעים. לא ניתן להימנע מהתנגשויות כאלה בשל אופן פעולת הדפדפן."

msgid "options_conflicts_lowerPriority"
msgstr "תג אדום כזה על סמל SwitchyDelta מציין שאפליקציה אחרת בעלת עדיפות גבוהה יותר ולכן SwitchyDelta אינו יכול לשלוט בהגדרות. נסה להסיר את SwitchyDelta ולהתקין מחדש, מה שאמור להעלות את עדיפות SwitchyDelta. אם עדיין מופיעות התנגשויות לאחר ההתקנה מחדש, שקול להסיר את האפליקציה האחרת שגורמת להתנגשות."

msgid "options_conflicts_higherPriority"
msgstr "אם ל-SwitchyDelta יש עדיפות גבוהה יותר, ניתן להחזיר את השליטה לאפליקציות אחרות או להגדרות המערכת על ידי בחירת $SYSTEMPROFILE$ בתפריט הקופץ."

msgid "options_showExternalProfile"
msgstr "הצג פריט בתפריט הקופץ לייבוא הגדרות פרוקסי מאפליקציות אחרות."

msgid "options_showExternalProfileHelp"
msgstr "כאשר $SYSTEMPROFILE$ נבחר, ניתן לייבא את הגדרות הפרוקסי הפעילות מאפליקציות אחרות על ידי בחירת $EXTERNALPROFILE$ בתפריט הקופץ. ההגדרות ייובאו כפרופיל בשם שתספק. שים לב שהפרופיל המיובא הוא תמונת מצב ולא ישקף שינויים מהאפליקציה המקורית לאחר מכן."

