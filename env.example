# Chrome Web Store publishing (scripts/publish-chrome.mjs).
# Copy to .env and fill in; .env is gitignored — never commit real values.

# Google Cloud service-account key, linked to the publisher in the CWS
# developer dashboard (Account > Service account). Keep it OUTSIDE the repo.
CWS_KEY_PATH=/absolute/path/to/service-account-key.json

# Store item id. Obtained from the dashboard after the one-time first upload
# (new items cannot be created through the API).
#CWS_ITEM_ID=

# Publisher id from the dashboard. When set, the V2 API is used; without it
# the V1.1 API is used, which Google supports until 2026-10-15.
#CWS_PUBLISHER_ID=

# Optional: proxy for reaching googleapis.com.
#HTTPS_PROXY=http://127.0.0.1:7890
